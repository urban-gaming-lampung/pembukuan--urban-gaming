rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // CATATAN: Storage rules SENGAJA tidak memanggil firestore.get/exists (cross-service).
    // Pengecekan lintas layanan sempat membuat upload & getDownloadURL pegawai gagal.
    // Pembatasan utama data URBAN ada di Firestore rules; di Storage: file hanya bisa
    // dibuka per-file (get) oleh akun login, sedangkan daftar isi folder (list) hanya owner,
    // jadi akun luar tidak bisa menjelajah/menebak file.
    function isOwner() {
      return request.auth != null && request.auth.token.email == "owner@gmail.com";
    }
    function isOwnEmail(email) {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.email.lower() == email.lower();
    }
    function isImageUnder(mb) {
      return request.resource.contentType.matches('image/.*') && request.resource.size < mb * 1024 * 1024;
    }

    // Foto Absensi Karyawan: upload ke folder email sendiri, tidak bisa diubah/dihapus
    match /absensi/{email}/{allPaths=**} {
      allow create: if isOwnEmail(email);
      allow get: if isOwnEmail(email) || isOwner();
      allow list: if isOwner();
      allow update, delete: if false;
    }

    // Bukti Transfer Pemasukan & Pengeluaran
    match /bukti_transfer/{dateStr}/{fileName} {
      allow create: if request.auth != null && request.auth.token.email != null;
      allow get: if request.auth != null;
      allow list: if isOwner();
      allow update, delete: if false;
    }

    // Foto Profil & Background Pegawai
    match /profile_photos/{email}/{fileName} {
      allow get: if request.auth != null;
      allow list: if isOwner();
      allow write: if isOwnEmail(email) && isImageUnder(3);
    }

    // Galeri Media Sosial (upload oleh owner)
    match /gallery_media/{allPaths=**} {
      allow get: if request.auth != null;
      allow list, write: if isOwner();
    }

    // Foto Produk POS
    match /products/{allPaths=**} {
      allow get: if request.auth != null;
      allow list, write: if isOwner();
    }

    // Save Data Cloud ProsperoEden (Switch Mod) — tidak diubah
    match /saves/{uid}/{titleId} {
      allow read: if request.auth != null && (request.auth.uid == uid || isOwner());
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Share Postingan Screenshot ProsperoEden — tidak diubah
    match /share/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && (request.auth.uid == uid || isOwner());
    }

    // Akses Owner
    match /{allPaths=**} {
      allow read, write: if isOwner();
    }
  }
}
