rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Staf URBAN = owner atau punya dokumen Firestore users/{email} (bukan akun ProsperoEden).
    function isOwner() {
      return request.auth != null && request.auth.token.email == "owner@gmail.com";
    }
    function isUrbanStaff() {
      return isOwner()
        || (request.auth != null && request.auth.token.email != null
            && firestore.exists(/databases/(default)/documents/users/$(request.auth.token.email.lower())));
    }
    function isUrbanAdmin() {
      return isOwner()
        || (request.auth != null && request.auth.token.email != null
            && firestore.get(/databases/(default)/documents/users/$(request.auth.token.email.lower())).data.role == "super admin");
    }
    function isOwnEmail(email) {
      return request.auth != null && request.auth.token.email.lower() == email.lower();
    }
    function isImageUnder(mb) {
      return request.resource.contentType.matches('image/.*') && request.resource.size < mb * 1024 * 1024;
    }

    // Foto Absensi Karyawan: upload ke folder email sendiri, tidak bisa diubah/dihapus
    match /absensi/{email}/{allPaths=**} {
      allow create: if isUrbanStaff() && isOwnEmail(email);
      allow read: if isUrbanAdmin() || (isUrbanStaff() && isOwnEmail(email));
      allow update, delete: if false;
    }

    // Bukti Transfer Pemasukan & Pengeluaran
    match /bukti_transfer/{dateStr}/{fileName} {
      allow create: if isUrbanStaff();
      allow read: if isUrbanStaff();
      allow update, delete: if false;
    }

    // Foto Profil Pegawai
    match /profile_photos/{email}/{fileName} {
      allow read: if isUrbanStaff();
      allow write: if isUrbanStaff() && isOwnEmail(email) && isImageUnder(2);
    }

    // Galeri Media Sosial
    match /gallery_media/{allPaths=**} {
      allow read: if isUrbanStaff();
      allow write: if isUrbanAdmin();
    }

    // Foto Produk POS
    match /products/{allPaths=**} {
      allow read: if isUrbanStaff();
      allow write: if isUrbanAdmin();
    }

    // Save Data Cloud ProsperoEden (Switch Mod) — tidak diubah
    match /saves/{uid}/{titleId} {
      allow read: if request.auth != null && (request.auth.uid == uid || isOwner());
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Share Postingan Screenshot ProsperoEden — tidak diubah
    match /share/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && (request.auth.uid == uid || isOwner());
    }

    // Akses Owner
    match /{allPaths=**} {
      allow read, write: if isOwner();
    }
  }
}
