rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // Helper Akses
    // ==========================================
    // Project Firebase ini dipakai bersama ProsperoEden. Akun ProsperoEden juga "login",
    // jadi `request.auth != null` TIDAK cukup untuk data URBAN. Staf URBAN = owner, atau
    // punya dokumen users/{email} yang tidak dinonaktifkan.
    function isOwner() {
      return request.auth != null && request.auth.token.email == "owner@gmail.com";
    }
    function staffPath() {
      return /databases/$(database)/documents/users/$(request.auth.token.email.lower());
    }
    function isUrbanStaff() {
      return isOwner()
        || (request.auth != null && request.auth.token.email != null
            && exists(staffPath())
            && get(staffPath()).data.get('status', 'aktif') != 'nonaktif');
    }
    function isSalaryAdmin() {
      return isOwner()
        || (request.auth != null && request.auth.token.email != null
            && exists(staffPath())
            && get(staffPath()).data.role == "super admin");
    }
    function isOwnEmail(email) {
      return request.auth != null && request.auth.token.email.lower() == email.lower();
    }

    // ==========================================
    // Aturan Profil Pegawai (users & logs)
    // ==========================================
    match /pegawai_logs/{email} {
      allow read: if isUrbanStaff();
      allow write: if (isUrbanStaff() && isOwnEmail(email)) || isSalaryAdmin();
    }

    match /users/{userId} {
      // Dokumen ber-ID email = akun URBAN (hanya staf). Dokumen ber-ID UID = profil ProsperoEden.
      allow read: if isUrbanStaff()
                  || isOwnEmail(userId)
                  || (request.auth != null && (request.auth.uid == userId || !userId.matches('.*@.*')));
      // Akun URBAN hanya dibuat owner / super admin (Kelola Akun Pegawai).
      allow create: if isSalaryAdmin()
                    || (request.auth != null && request.auth.uid == userId && !userId.matches('.*@.*'));
      // Pegawai boleh ubah profilnya sendiri (foto, tema, dll) TAPI tidak boleh ubah role/status.
      allow update: if isSalaryAdmin()
                    || (request.auth != null && request.auth.uid == userId && !userId.matches('.*@.*'))
                    || (isOwnEmail(userId)
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']));
      allow delete: if isSalaryAdmin();

      // Save Data Cloud (ProsperoEden) metadata subcollection
      match /saves/{titleId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isOwner());
        allow write: if request.auth != null && (request.auth.uid == userId || isOwner());
      }
    }

    // ==========================================
    // Aturan Database Gaji (Krusial: Anti-Manipulasi Karyawan)
    // ==========================================
    match /gaji_pegawai/{email} {
      allow read: if isUrbanStaff();
      // Revision checks reject old application versions that replace salary arrays.
      // Staff still write their own attendance penalties using a transaction.
      allow create: if isUrbanStaff()
        && (isOwnEmail(email) || isSalaryAdmin())
        && request.resource.data.salaryRevision == 1;
      allow update: if isUrbanStaff()
        && (isOwnEmail(email) || isSalaryAdmin())
        && request.resource.data.salaryRevision == resource.data.get('salaryRevision', 0) + 1;
      // Keep financial history even after a user profile is removed.
      allow delete: if false;
    }

    // ==========================================
    // Aturan Rekam Jejak Absensi (log_absensi)
    // ==========================================
    match /log_absensi/{docId} {
      allow read: if isUrbanStaff();
      // Karyawan bisa CREATE absensi dan UPDATE status (misal: tutup buku harian -> 'completed')
      allow create, update: if isUrbanStaff();
      // Hanya Owner dan Super Admin yang berhak menghapus rekam jejak
      allow delete: if isSalaryAdmin();
    }

    // ==========================================
    // Aturan Database Pembukuan Sehari-hari
    // ==========================================
    match /history_pembukuan/{docId} {
      allow read, write: if isUrbanStaff();
    }

    // ==========================================
    // Aturan Folder Data Umum (Stok, Draft Form, Pengaturan)
    // ==========================================
    match /data/{docId} {
      allow read: if isUrbanStaff();
      allow write: if isUrbanStaff() && docId != 'settings';
    }

    match /data/settings {
      allow read: if isUrbanStaff();
      allow create: if isUrbanStaff()
        && (!request.resource.data.keys().hasAny(['rincianVisibility']) || isSalaryAdmin())
        && (!request.resource.data.keys().hasAny(['priceLists', 'priceListsRevision', 'settings'])
          || (isSalaryAdmin() && request.resource.data.priceListsRevision == 1));
      allow update: if isUrbanStaff()
        // Tampil/sembunyi tabel rincian Usaha Rental hanya oleh owner / super admin
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rincianVisibility']) || isSalaryAdmin())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['priceLists', 'priceListsRevision', 'settings'])
          || (isSalaryAdmin()
            && request.resource.data.priceListsRevision == resource.data.get('priceListsRevision', 0) + 1));
      allow delete: if false;
    }

    // ==========================================
    // Aturan Sistem Presensi Realtime (Titik Radar)
    // ==========================================
    match /presence/{uid} {
      allow read: if isUrbanStaff();
      allow write: if isUrbanStaff() && request.auth.uid == uid;
    }

    // ==========================================
    // Aturan POS Products (products)
    // ==========================================
    match /products/{productId} {
      allow read: if true;
      allow write: if isSalaryAdmin();
    }

    // ==========================================
    // Aturan Monitoring Kondisi Unit (monitoring_devices)
    // ==========================================
    match /monitoring_devices/{deviceId} {
      allow read, create, update: if isUrbanStaff();
      allow delete: if isSalaryAdmin();
    }

    // ==========================================
    // Aturan Galeri Media Sosial (media_gallery)
    // ==========================================
    match /media_gallery/{mediaId} {
      allow read: if isUrbanStaff();
      allow write: if isSalaryAdmin();
    }

    // ==========================================
    // Aturan Eksekutif Owner (Buku Pengeluaran Pribadi, Asisten AI)
    // ==========================================
    match /owner_expenses/{docId} {
      allow read, write: if isSalaryAdmin();
    }

    // Pemasukan owner (modal masuk, suntikan dana, pemasukan lain) — Input › Transaksi › Pemasukan
    match /owner_incomes/{docId} {
      allow read, write: if isSalaryAdmin();
    }

    match /owner_assistants/{docId} {
      allow read, write: if isSalaryAdmin();
    }

    // ==========================================
    // Aturan Logging Pembukuan (pembukuan_logs)
    // ==========================================
    match /pembukuan_logs/{docId} {
      allow read: if isSalaryAdmin();
      allow write: if isUrbanStaff();
    }

    // ==========================================
    // Aturan Request Edit (edit_requests)
    // ==========================================
    match /edit_requests/{docId} {
      allow create: if isUrbanStaff();
      allow read, update, delete: if isSalaryAdmin();
    }

    // ==========================================
    // Aturan Fitur Game (Challenge & Leaderboard)
    // ==========================================
    match /data/game_config {
      allow read: if isUrbanStaff();
      allow write: if isSalaryAdmin();
    }

    match /game_leaderboard/{docId} {
      allow read: if isUrbanStaff();
      allow write: if isSalaryAdmin();
    }

    match /game_winners/{monthKey} {
      allow read: if isUrbanStaff();
      allow write: if false;
    }

    match /game_attempts/{attemptId} {
      allow read: if request.auth != null
                  && resource.data.email.lower() == request.auth.token.email.lower();
      allow write: if false;
    }

    // ==========================================
    // Aturan Catatan Admin & Link Permanen (admin_notes)
    // ==========================================
    match /admin_notes/{noteId} {
      allow read: if isUrbanStaff();
      allow write: if isSalaryAdmin();
    }

    // ==========================================
    // Riwayat Stok Jualan (masuk / terjual / rusak / koreksi)
    // ==========================================
    match /stok_log/{logId} {
      allow read, create: if isUrbanStaff();
      // Riwayat tidak boleh diubah pegawai; koreksi hanya owner / super admin
      allow update, delete: if isSalaryAdmin();
    }

    // ==========================================
    // Transaksi POS (nota penjualan usaha)
    // Dibuat kasir saat nota dicetak; batal / hapus hanya owner / super admin
    // ==========================================
    match /pos_transaksi/{saleId} {
      allow read, create: if isUrbanStaff();
      // Kasir hanya boleh: menambahkan link PDF nota (untuk WhatsApp pembeli), dan
      // MELUNASI nota DP (status DP -> LUNAS + riwayat pembayaran). Batal / hapus: owner.
      allow update: if isSalaryAdmin()
        || (isUrbanStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notaUrl']))
        || (isUrbanStaff()
          && resource.data.get('status', '') == 'DP'
          && request.resource.data.status == 'LUNAS'
          && request.resource.data.get('batal', false) == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'pembayaran', 'lunasTs', 'lunasOleh', 'stokKurang', 'notaUrl']));
      allow delete: if isSalaryAdmin();
    }

    // Harga modal barang jualan (privat: products dibaca publik, jadi modal disimpan terpisah)
    match /product_costs/{productId} {
      allow read, write: if isSalaryAdmin();
    }

    // Catatan stok masuk barang jualan (berisi harga modal) — owner / super admin
    match /stok_masuk/{masukId} {
      allow read, write: if isSalaryAdmin();
    }

    // ==========================================
    // Aturan Share Screenshots (ProsperoEden) — tidak diubah
    // ==========================================
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isSalaryAdmin());

      match /likes/{likeUid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == likeUid;
      }
    }

    // ==========================================
    // Aturan Sisa / Fallback (Menutup semua yang tidak terdaftar)
    // ==========================================
    match /{collectionId}/{document=**} {
      allow read, write: if isOwner()
        && collectionId != 'gaji_pegawai' && collectionId != 'data';
    }
  }
}
